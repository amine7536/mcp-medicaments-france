{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mcp-medicaments-france",
	"main": "src/index.ts",
	"account_id": "7806bdd95447f476c67e586e0421c666",
	"compatibility_date": "2026-10-01",
	"workers_dev": false,
	"preview_urls": false,
	"secrets": {
		"required": ["ADMIN_TOKEN"]
	},
	"triggers": {
		"crons": ["0 5 * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ruptures",
			"database_id": "9bc8faf1-2bd8-42a5-9d79-ccfdf7d938b5",
			"migrations_dir": "migrations"
		}
	],
	"analytics_engine_datasets": [
		{
			"binding": "USAGE",
			"dataset": "ruptures_usage"
		}
	],
	"ratelimits": [
		{
			"name": "MCP_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	"routes": [
		{
			"pattern": "medicaments-france.a3e.dev",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": false
		}
	},
	"env": {
		"candidate": {
			"workers_dev": true,
			"preview_urls": false,
			"routes": [],
			"triggers": {
				"crons": []
			},
			"secrets": {
				"required": ["ADMIN_TOKEN"]
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "ruptures-candidate",
					"database_id": "c3d5c605-eb12-4bc4-88f2-df0617d0953b",
					"migrations_dir": "migrations"
				}
			],
			"analytics_engine_datasets": [
				{
					"binding": "USAGE",
					"dataset": "ruptures_candidate_usage"
				}
			],
			"ratelimits": [
				{
					"name": "MCP_LIMIT",
					"namespace_id": "1002",
					"simple": {
						"limit": 60,
						"period": 60
					}
				}
			]
		}
	}
}

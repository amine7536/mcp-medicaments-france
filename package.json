{
  "name": "mcp-medicaments-france",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types --check && tsc && tsc -p test",
    "test": "vitest run",
    "bdpm:import": "tsx scripts/bdpm-import.ts",
    "bdpm:apply": "wrangler d1 execute ruptures --remote --file .bdpm/bdpm.sql --yes",
    "bdpm:apply:local": "wrangler d1 execute ruptures --local --file .bdpm/bdpm.sql --yes",
    "match:report": "tsx scripts/match-report.ts",
    "golden": "tsx scripts/golden.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.31.0",
    "entities": "8.1.0",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.153.0"
  }
}
